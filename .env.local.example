# Frontend local development environment
# Copy to `.env.local` for Vite local development.
# For a full local Supabase stack, use the local API URL and anon key from `supabase start`.
# If you keep remote auth but want local edge functions, set VITE_SUPABASE_URL to your hosted project
# and point VITE_SUPABASE_FUNCTIONS_URL to your local functions gateway.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321
VITE_CV_EXTRACTOR_URL=http://127.0.0.1:8000
APP_ORIGIN=http://localhost:5173
