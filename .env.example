# Replace these with your actual Supabase project credentials.
# Never commit real credentials to version control.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co
VITE_CV_EXTRACTOR_URL=https://your-python-backend.example.com
APP_ORIGIN=http://localhost:5173
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Server-only secret. Never expose this in src/ or client builds.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# CV extraction backend
# Local development can stay on SQLite with the default auto mode.
# In production, prefer Postgres and point CV_PARSER_DATABASE_URL to your managed database or Supabase Postgres connection string.
CV_PARSER_STAGE_BACKEND=auto
CV_PARSER_DATABASE_URL=postgresql://postgres:password@db.host:5432/postgres
CV_STAGE_TTL_MINUTES=60
CV_MAX_UPLOAD_BYTES=5242880
CV_MAX_MATCH_CRITERIA_BYTES=32768
CV_EXTRACTION_TIMEOUT_SECONDS=20
CV_LLM_TIMEOUT_SECONDS=45
CV_MAX_PDF_PAGES=40
CV_DOCX_MAX_XML_BYTES=8388608
CV_DOCX_MAX_ARCHIVE_MEMBERS=256
CV_TEXT_BINARY_RATIO_LIMIT=0.30
CV_LLM_MIN_TEXT_CHARS=250
CV_LLM_MAX_TEXT_CHARS=16000
CV_LLM_MIN_ALPHA_RATIO=0.55
CV_LLM_MAX_SUSPICIOUS_RATIO=0.18
CV_LLM_MIN_UNIQUE_LINE_RATIO=0.45
CV_LLM_MAX_DUPLICATE_LINE_SHARE=0.45
CV_ENABLE_LITEPARSE_FALLBACK=false
CV_DEDOC_URL=
CV_COOKIE_SECURE=false
CV_PARSER_DB_POOL_MAX_SIZE=5

# LLM provider for CV parsing
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=45
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# App branding
VITE_APP_OWNER=Precious Ajayi